{
  "name": "@pixpilot/github-app",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "description": "Creates and manages GitHub apps.",
  "author": "Mo Doaie <m.doaie@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/pixpilot/github-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixpilot/github-tools.git",
    "directory": "packages/github-app"
  },
  "bugs": {
    "url": "https://github.com/pixpilot/github-tools/issues"
  },
  "keywords": [
    "github",
    "github-app",
    "cli",
    "release",
    "manifest"
  ],
  "sideEffects": false,
  "exports": "./src/index.ts",
  "bin": {
    "github-app": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "pnpm clean && git clean -xdf node_modules",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui --watch",
    "test:ui:coverage": "vitest --ui --coverage --watch --hookTimeout=30000 --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "cli:release": "tsx src/cli.ts",
    "cli:release.release": "tsx src/cli.ts create releaser --manifest releaser.json"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tsdown-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@types/node": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:testing",
    "@vitest/ui": "catalog:testing",
    "eslint": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "tsx": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:testing"
  },
  "prettier": "@internal/prettier-config"
}
